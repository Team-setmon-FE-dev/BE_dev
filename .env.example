# ─────────────────────────────────────────────────────────────
# GitHub Actions CI/CD Secrets
# Settings → Secrets and variables → Actions 에 등록
# ─────────────────────────────────────────────────────────────
DOCKER_USERNAME=your_dockerhub_username
DOCKER_PASSWORD=your_dockerhub_password
EC2_HOST=your_ec2_ip_address

# EC2_SSH_KEY: GitHub Secret 에는 PEM 파일 전체 내용을 붙여넣기
# EC2_SSH_KEY_PATH: 로컬에서는 파일 경로를 사용 (예: ~/.ssh/setmon-key.pem)
EC2_SSH_KEY_PATH=/path/to/your/setmon-key.pem

# ─────────────────────────────────────────────────────────────
# 서버 실행용 (.env 로 복사 후 채우기 — .env 는 커밋 금지)
# docker-compose.yml: MYSQL_ROOT_PASSWORD=rootpassword 와 일치시킬 것
# ─────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/setmon?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=rootpassword

# JWT: Base64 인코딩된 32바이트 이상 랜덤 키
JWT_SECRET=

AWS_REGION=ap-northeast-2
S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

FIREBASE_KEY_PATH=
